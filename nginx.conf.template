worker_processes auto;
events { worker_connections 1024; }

http {
    # ============================================
    # FIX: "400 Request Header Or Cookie Too Large"
    # nginx's defaults (client_header_buffer_size 1k,
    # large_client_header_buffers 4x8k) are too small for
    # the panel's session cookie, especially once a CSRF
    # token and a couple of re-logins pile cookies up in
    # the browser. Raise them here, on both the request
    # side (headers coming FROM the browser) and the
    # proxy side (headers coming back FROM x-ui, which
    # nginx also has to buffer before relaying).
    # ============================================
    client_header_buffer_size 16k;
    large_client_header_buffers 4 32k;
    proxy_buffer_size 16k;
    proxy_buffers 8 16k;
    proxy_busy_buffers_size 32k;

    # ============================================
    # Standard nginx WebSocket-upgrade pattern. Hardcoding
    # `Connection: upgrade` on every request (the previous
    # version) forces a protocol-upgrade attempt even on
    # plain HTTP requests (health checks, scanners, normal
    # GETs) that never asked for one — that's what was
    # producing the "Unauthorized WebSocket connection
    # attempt" / securecookie noise in the logs. This only
    # sends `Connection: upgrade` when the client actually
    # sent an Upgrade header.
    # ============================================
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    server {
        listen ${NGINX_PORT};
        server_name _;

        # ============================================
        # HEALTH CHECK - harmless, helps Railway/you
        # confirm nginx itself is alive
        # ============================================
        location /health {
            access_log off;
            return 200 "healthy\n";
            add_header Content-Type text/plain;
        }

        location /ping {
            access_log off;
            return 200 "pong\n";
            add_header Content-Type text/plain;
        }

        # ============================================
        # PANEL WEB INTERFACE
        # ============================================
        location /managepanel/ {
            proxy_pass http://127.0.0.1:2053/managepanel/;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # ============================================
        # SUBSCRIPTION LINKS
        # ============================================
        location /sub/ {
            proxy_pass http://127.0.0.1:2096/sub/;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # ============================================
        # MAIN INBOUND (VLESS/WebSocket)
        # proxy_buffering off + long timeouts are REQUIRED
        # for VLESS-over-WS to work through nginx. Without
        # these, the panel works but the actual proxied
        # config traffic stalls or breaks.
        # ============================================
        location / {
            proxy_pass http://127.0.0.1:8080;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_buffering off;
            proxy_request_buffering off;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
            client_max_body_size 0;
        }

        # ============================================
        # MULTI-LOCATION INBOUNDS (1-8)
        # Same WebSocket fixes + same forwarded headers as
        # the main location. /in9 (the old "random" exit)
        # has been removed — only the 8 real, strictly
        # pinned countries remain.
        # ============================================
        location /in1 {
            proxy_pass http://127.0.0.1:8081;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_buffering off;
            proxy_request_buffering off;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
        }
        location /in2 {
            proxy_pass http://127.0.0.1:8082;
            proxy_http_version 1.1;
