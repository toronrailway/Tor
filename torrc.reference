# ============================================================
# REFERENCE ONLY — NOT read or used by start.sh or the Dockerfile.
#
# start.sh generates each Tor instance's actual config inline
# (see the render_instance() function in start.sh) rather than
# substituting placeholders in this file. This file documents
# what each of the 8 generated per-country configs looks like
# conceptually — one independent Tor process per country, each
# with its own DataDirectory, SocksPort, and strictly-enforced
# ExitNodes, so they can never bleed into each other. The old
# 9th "random"/no-ExitNodes instance has been removed — every
# instance below is now a mandatory, single-country circuit.
# Safe to delete from your repo; nothing references it.
# ============================================================

DataDirectory __DATADIR__
PidFile __PIDFILE__
SocksPort __SOCKSPORT__

# Mandatory country pin for this instance. Every instance now
# has one — there is no "random" case anymore.
ExitNodes {__COUNTRY_CODE__}
StrictNodes 1

NumEntryGuards 4
NumDirectoryGuards 3
CircuitBuildTimeout 60
KeepalivePeriod 600
ExcludeExitNodes {ir},{kp},{cn},{ru},{sy},{cu},{ve}

Log notice file __LOGDIR__/notices.log
Log warn file __LOGDIR__/warnings.log
LogTimeGranularity 1
