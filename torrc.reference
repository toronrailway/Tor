# ============================================================
# REFERENCE ONLY — NOT read or used by start.sh or the Dockerfile.
#
# start.sh generates each Tor instance's actual config inline
# (see the render_instance() function in start.sh) rather than
# substituting placeholders in this file. This file is kept only
# as human-readable documentation of what each generated config
# looks like conceptually — one independent Tor process per
# country, each with its own DataDirectory, SocksPort, and
# ExitNodes, so they can never bleed into each other. Safe to
# delete from your repo; nothing references it.
# ============================================================

DataDirectory __DATADIR__
PidFile __PIDFILE__
SocksPort __SOCKSPORT__

# Country pin for this instance only. Left empty by the
# generator for the "random" instance (no ExitNodes line at
# all = Tor picks any exit, which is what "random" means here).
__EXITNODES_LINE__

StrictNodes 1
NumEntryGuards 4
NumDirectoryGuards 3
CircuitBuildTimeout 60
KeepalivePeriod 600
ExcludeExitNodes {ir},{kp},{cn},{ru},{sy},{cu},{ve}

Log notice file __LOGDIR__/notices.log
Log warn file __LOGDIR__/warnings.log
LogTimeGranularity 1
